# Cloudflare Pages reads this file directly. Inert unless you connect that
# host. Kept in step with vercel.json and netlify.toml by hand — same CSP,
# same HSTS, same everything, so moving hosts changes nothing the browser
# sees.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://uyhbtubxmycofdyuajkn.supabase.co wss://uyhbtubxmycofdyuajkn.supabase.co; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  Cache-Control: public, max-age=0, must-revalidate

/supabase/*
  X-Robots-Tag: noindex

/scripts/*
  X-Robots-Tag: noindex
